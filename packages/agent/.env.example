# Autonr agent settings. Copy this file to .env in the same folder: the CLIs and the Next.js server both read
# packages/agent/.env. Private keys stay on the server; the dashboard only ever receives public data.

# Network: testnet or mainnet.
HEDERA_NETWORK=testnet
# JSON-RPC relay; defaults to hashio for the network.
HEDERA_RPC_URL=
# Mirror Node REST root; defaults to the public Mirror Node for the network.
HEDERA_MIRROR_URL=

# Vault owner: the ECDSA account that deployed the vault. Used by the agent:setup and vault:fund scripts.
OPERATOR_ACCOUNT_ID=
# Raw 32-byte hex (with or without 0x) or the DER hex shown in the Hedera Portal. ED25519 keys cannot sign EVM calls.
OPERATOR_PRIVATE_KEY=

# The agent: one ECDSA key signs its HCS decisions and its vault trades. agent:setup creates the account if empty.
AGENT_ACCOUNT_ID=
# Same formats as OPERATOR_PRIVATE_KEY. agent:setup writes it when it creates the agent.
AGENT_PRIVATE_KEY=

# Your AgentVault. When this and AUTONR_TOPIC_ID are empty, the dashboard shows the reference deployment, if any.
AUTONR_VAULT_ADDRESS=
# HCS topic holding the agent's decisions (0.0.x). agent:setup creates it with the agent as the only submitter.
AUTONR_TOPIC_ID=
# Optional, read only by the deploy script: the agent's EVM address for a new vault (default: the deployer).
# agent:setup points an existing vault at the agent anyway, so this only saves a transaction.
AUTONR_AGENT_ADDRESS=

# SaucerSwap V2 fee tier of the base/quote pool (hundredths of a basis point); defaults to 3000 on testnet, 1500 on mainnet.
AUTONR_POOL_FEE=
# Replaces the base token (default WHBAR), as JSON; pricing defaults to Chainlink HBAR / USD with a Supra cross-check.
AUTONR_BASE_TOKEN=
# Replaces the quote token (default USDC), as JSON, e.g. '{"symbol":"USDT","id":"0.0.1234","decimals":6,"supraPairId":48,"supraLabel":"USDT_USD"}'.
AUTONR_QUOTE_TOKEN=

# Strategy: rebalance (deterministic) or llm (needs ANTHROPIC_API_KEY).
AUTONR_STRATEGY=rebalance
# Largest trade the rebalance strategy proposes, in USD; the vault's per-trade cap still applies.
AUTONR_TRADE_USD=5
# Share of the vault's USD value the rebalance strategy keeps in the base token, from 0 to 1.
AUTONR_TARGET_BASE_WEIGHT=0.5
# Publish holds to the decision topic as well; trades and refusals are always published.
AUTONR_LOG_HOLDS=true

# Anthropic API key for the llm strategy; optional otherwise.
ANTHROPIC_API_KEY=
# Claude model for the llm strategy; it must support structured outputs and the effort setting.
AUTONR_LLM_MODEL=claude-sonnet-5-5

# Lets the dashboard run agent ticks through POST /api/agent/tick. Leave false on any server others can reach.
AUTONR_ENABLE_TICK_API=false
# When set, tick requests must send it in the x-autonr-secret header.
AUTONR_TICK_API_SECRET=

# Hedera SDK transport for HCS and account/topic creation: "web" (gRPC-web over HTTPS 443, default; works through
# firewalls and VPNs) or "native" (gRPC on ports 50211/50212).
# HEDERA_GRPC_TRANSPORT=native
