# Foundry package settings, copied to .env on install.
# The deploy settings AUTONR_AGENT_ADDRESS and AUTONR_TOPIC_ID belong in packages/agent/.env, which `yarn deploy` loads
# too, so one env file serves the whole template.

# JSON-RPC endpoint that `yarn fork` forks (Hedera testnet by default; https://mainnet.hashio.io/api for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Keystore for local deploys. scaffold-hbar-default is a prefunded local account; set the name of one of your own
# keystores (`yarn account:import`) to deploy locally from it instead.
LOCALHOST_KEYSTORE_ACCOUNT=scaffold-hbar-default
